# Keep secrets OUT of the build context — the image must never contain these.
.env
.env.*

# The build only needs: pyproject.toml, uv.lock, README.md, src/.
# Everything below is excluded to keep the context small and secret-free.

# VCS + CI
.git
.gitignore
.github

# Python caches / local venv / coverage
.venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Infra / docs / data / dev tooling — not part of the runtime image
infra
docs
# data/ is intentionally NOT excluded (ADR 0018, superseding 0017): the Dockerfile
# `bootstrap` target bakes data/corpus/ (manifest.json + the cached PDFs, ~45 MB) into
# the one-off ingest image. FDA/Akamai blocks the Fargate datacenter IP, so
# re-downloading at runtime 4xx-fails (50/50 failed in the first cloud run). With the
# PDFs baked in, ingest hits the cache (dest.exists()) and skips the fetch. The minimal
# serving image COPYs no data/, so its image is unaffected — only the serving build
# *context* grows by ~45 MB, which is acceptable.
evals
tests
scripts
init-db
notebooks
memory
.claude
Scratch

# Compose + editor cruft
docker-compose.yml
*.swp
.DS_Store
