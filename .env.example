# Copy to .env and fill in. .env is gitignored.
#
# This file holds BOTH:
#   - Application config (read by Pydantic Settings in src/rra/config.py)
#   - Docker Compose-time secrets (substituted into docker-compose.yml)
# They coexist happily because Compose only reads the variables it references
# and Pydantic Settings ignores extras (`extra="ignore"`).

# ─── LLM provider keys ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# ─── Postgres (app DB) ───────────────────────────────────────────────────────
# Matches docker-compose.yml. Change both if you change either.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rra
POSTGRES_PASSWORD=rra_dev_password
POSTGRES_DB=rra
DATABASE_URL=postgresql://rra:rra_dev_password@localhost:5432/rra

# ─── Langfuse — application-side (read by the SDK in src/rra/*) ──────────────
# Get the public/secret keys from http://localhost:3000 after first login:
#   Settings → API Keys → Create new key
# Leave blank until you've created an account in the local Langfuse UI.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Langfuse — compose-side (read by docker-compose.yml at container start) ─
# Generate these ONCE per local install with:
#   echo "LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)" >> .env
#   echo "LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)" >> .env
#   echo "LANGFUSE_SALT=$(openssl rand -base64 32)" >> .env
#
# DO NOT commit real values to git. The compose file uses ${VAR:?err} so it
# refuses to start if any are missing.
#
# IMPORTANT: changing ENCRYPTION_KEY or SALT after data exists makes existing
# encrypted records unreadable. Generate once, then leave alone unless wiping
# the langfuse-postgres volume.
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# ─── API auth (v1 — single key, replaced by OAuth 2.0 in prod design) ────────
RRA_API_KEY=dev-key-change-me

# ─── Model selection ─────────────────────────────────────────────────────────
PLANNER_MODEL=claude-sonnet-4-5
ANALYST_MODEL=claude-sonnet-4-5
CRITIC_MODEL=claude-sonnet-4-5
RESEARCHER_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-haiku-4-5

# ─── Test / eval gates ───────────────────────────────────────────────────────
# Critic force-verdict gate — TEST/EVAL ONLY. Leave unset in production.
# Valid values: approve | revise | escalate. Unset = normal critic behavior.
# RRA_CRITIC_FORCE_VERDICT=

# ─── Retrieval tuning ────────────────────────────────────────────────────────
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
RERANK_MODEL=rerank-2
RETRIEVE_TOP_K=25
RERANK_TOP_K=5
MAX_CRITIC_REVISIONS=2

# ─── Chunking ────────────────────────────────────────────────────────────────
# Changing these requires re-running the ingest script.
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# ─── Cost guardrails ─────────────────────────────────────────────────────────
MAX_TOKENS_PER_QUERY=200000
MAX_TOOL_CALLS_PER_QUERY=20